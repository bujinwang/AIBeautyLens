{
  "cli": {
    "version": ">= 5.9.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-sonoma-14.6-xcode-16.0",
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_GEMINI_API_KEY": "AIzaSyCF5JIUoRuuqb5Cd6D31_aSjsZ7Wm_85-w"
      }
    },
    "production-us": {
      "extends": "production",
      "env": {
        "APP_REGION": "US",
        "EXPO_PUBLIC_DEFAULT_LANGUAGE": "en"
      }
    },
    "production-china": {
      "extends": "production",
      "env": {
        "APP_REGION": "CN",
        "EXPO_PUBLIC_DEFAULT_LANGUAGE": "zh"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "bwang@autobebesys.com",
        "ascAppId": "6478294324",
        "appleTeamId": "8YA9NZNLCS"
      },
      "android": {
        "track": "production"
      }
    },
    "production-us": {
      "extends": "production"
    },
    "production-china": {
      "extends": "production"
    }
  }
}