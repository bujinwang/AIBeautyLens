# Git files
.git
.gitignore

# IDE and editor files
.vscode
.idea

# Node modules (will be handled inside Docker)
node_modules
*/node_modules
app/node_modules
backend/node_modules
shared/node_modules

# Build outputs (will be handled inside Docker)
dist
*/dist
backend/dist

# Local environment files
.env
*.env
.env.*
!backend/.env.example # Keep example env files if they are checked in

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store
Thumbs.db

# Test reports and coverage
coverage
.nyc_output